  coverImage  String?
  isPublished Boolean       @default(true)
  createdAt   DateTime      @default(now())

  items       GalleryItem[]

  @@index([category])
}

model GalleryItem {
  id        String   @id @default(uuid())
  galleryId String
  imageUrl  String
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  gallery   Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
}

model HeroSlider {
  id         String   @id @default(uuid())
  title      String
  subtitle   String?
  imageUrl   String
  buttonText String?
  buttonLink String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model PrincipalMessage {
  id                String   @id @default(uuid())
  title             String
  message           String   @db.Text
  authorName        String
  authorDesignation String
  imageUrl          String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
}

model ChairmanMessage {
  id                String   @id @default(uuid())
  title             String
  message           String   @db.Text
  authorName        String
  authorDesignation String
  imageUrl          String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
}

model SchoolStatistic {
  id        String   @id @default(uuid())
  label     String   // "Enrolled Students", "Faculty Members"
  value     String   // "1,850+", "120+"
  icon      String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Download {
  id             String       @id @default(uuid())
  title          String
  category       String       // "Prospectus", "Academic Calendar", "Exam Rules"
  fileUrl        String
  fileSize       String?
  targetAudience NoticeTarget @default(ALL)
  isPublished    Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@index([category])
}

// -----------------------------------------------------------------------------
// 11. COMMUNICATION DOMAIN (COMMUNICATION)
// -----------------------------------------------------------------------------

model Notification {
  id        String              @id @default(uuid())
  userId    String
  title     String
  message   String              @db.Text
  link      String?
  isRead    Boolean             @default(false)
  channel   NotificationChannel @default(IN_APP)
  createdAt DateTime            @default(now())

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model NotificationTemplate {
  id           String              @id @default(uuid())
  code         String              @unique // "FEE_DUE_REMINDER", "STUDENT_ABSENT_ALERT"
  channel      NotificationChannel @default(SMS)
  subject      String?
  templateBody String              @db.Text
  variables    Json?
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
}

model SMSLog {
  id             String             @id @default(uuid())
  recipientPhone String
  message        String             @db.Text
  gateway        String             @default("TWILIO")
  status         NotificationStatus @default(SENT)
  responseCode   String?
  sentAt         DateTime           @default(now())

  @@index([recipientPhone])
}

model EmailLog {
  id             String             @id @default(uuid())
  recipientEmail String
  subject        String
  body           String             @db.Text
  status         NotificationStatus @default(SENT)
  errorMessage   String?
  sentAt         DateTime           @default(now())

  @@index([recipientEmail])
}

// -----------------------------------------------------------------------------
// 12. SECURITY, AUDIT & CONFIGURATION (SECURITY)
// -----------------------------------------------------------------------------

model AuditLog {
  id         String      @id @default(uuid())
  actorId    String?
  action     AuditAction
  entityName String      // "Student", "Invoice", "Mark", "Payroll"
  entityId   String?
  beforeState Json?
  afterState  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  actor      User?       @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityName, entityId])
  @@index([createdAt])
}

model LoginHistory {
  id            String      @id @default(uuid())
  userId        String?
  email         String
  ipAddress     String?
  userAgent     String?
  status        LoginStatus @default(SUCCESS)
  failureReason String?
  loggedAt      DateTime    @default(now())

  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, loggedAt])
  @@index([email])
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  group       String   @default("GENERAL")
  description String?
  isPublic    Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([key])
}

// =============================================================================
// BIOMETRIC / FINGERPRINT ATTENDANCE DEVICE INTEGRATION
// Supports ZKTeco, eSSL, Suprema, Realand and any ADMS-compatible machine
// =============================================================================

enum BiometricDeviceStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

model BiometricDevice {
  id           String               @id @default(uuid())
  name         String               // e.g. "Main Gate Machine", "Admin Block"
  serialNumber String?              @unique
  ipAddress    String?
  location     String?              // physical location
  model        String?              // e.g. "ZKTeco K40"
  brand        String?              // e.g. "ZKTeco", "eSSL"
  status       BiometricDeviceStatus @default(ACTIVE)
  apiKey       String               @unique @default(uuid()) // secret token for machine pushes
  lastSeenAt   DateTime?
  lastSyncAt   DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  logs         BiometricLog[]

  @@index([apiKey])
  @@index([status])
}

model BiometricLog {
  id          String    @id @default(uuid())
  deviceId    String
  device      BiometricDevice @relation(fields: [deviceId], references: [id])
  
  // Raw punch data from machine
  machineUserId  String     // The user ID as stored in the device
  punchTime      DateTime   // Exact timestamp from machine
  punchType      String?    // IN / OUT (some machines send this)
  rawPayload     Json?      // Full raw data from machine for debugging

  // Resolved student/teacher link (nullable until matched)
  studentId   String?
  student     Student? @relation(fields: [studentId], references: [id])
  teacherId   String?
  teacher     Teacher? @relation(fields: [teacherId], references: [id])

  // Processing status
  processed   Boolean   @default(false)
  processedAt DateTime?
  attendanceId String?   // Reference to created StudentAttendance record
  notes       String?

  createdAt   DateTime @default(now())

  @@index([deviceId])
  @@index([machineUserId])
  @@index([punchTime])
  @@index([processed])
  @@index([studentId])
}

model BiometricUserMapping {
  id           String   @id @default(uuid())
  machineUserId String  // The ID enrolled in the biometric machine
  deviceId     String?  // Optional: per-device mapping
  studentId    String?
  student      Student? @relation(fields: [studentId], references: [id])
  teacherId    String?
  teacher      Teacher? @relation(fields: [teacherId], references: [id])
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([machineUserId, deviceId])
  @@index([machineUserId])
  @@index([studentId])
  @@index([teacherId])
}

