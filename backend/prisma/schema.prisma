model Event {
  id          String   @id @default(uuid())
  title       String
  description String   @db.Text
  venue       String?
  startDate   DateTime
  endDate     DateTime
  coverImage  String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

