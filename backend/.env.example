# =============================================================================
# ENVIRONMENT CONFIGURATION (.env.example)
# School Management System — Production Backend
# =============================================================================

# SERVER
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# DATABASE (Neon Serverless PostgreSQL)
# Pooled connection string for regular queries:
DATABASE_URL="postgresql://neondb_owner:npg_password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Direct connection string for Prisma migrations:
DIRECT_URL="postgresql://neondb_owner:npg_password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT AUTHENTICATION
JWT_ACCESS_SECRET="production-grade-jwt-access-secret-minimum-32-chars-long"
JWT_REFRESH_SECRET="production-grade-jwt-refresh-secret-minimum-32-chars-long"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# RATE LIMITING (Throttler)
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# INTEGRATIONS (Optional / Mock default)
TWILIO_ACCOUNT_SID="AC_mock_twilio_sid"
TWILIO_AUTH_TOKEN="mock_twilio_auth_token"
TWILIO_PHONE_NUMBER="+15550001122"

SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASS="mock_sendgrid_api_key"
SMTP_FROM="admissions@apexacademy.edu"
