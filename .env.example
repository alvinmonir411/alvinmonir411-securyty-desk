# =============================================================================
# ROOT ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# School Management System (SMS) — Enterprise Edition
# =============================================================================

# BACKEND
PORT=4000
NODE_ENV=production
CORS_ORIGIN=http://localhost:3000

# DATABASE (Neon Serverless PostgreSQL)
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# AUTHENTICATION
JWT_ACCESS_SECRET="production-grade-jwt-access-secret-minimum-32-chars-long"
JWT_REFRESH_SECRET="production-grade-jwt-refresh-secret-minimum-32-chars-long"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# FRONTEND
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
